# SurrealDB connection — INITIAL BOOTSTRAP ONLY
# Use server-level root credentials temporarily to create the initial namespace/database.
# Store the real password only in Coolify secrets; never commit it.
# Prefer the Coolify private service URL when both containers share a network.
SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=REPLACE_WITH_SERVER_ROOT_SECRET
# Set these to the namespace/database context used for bootstrap.
# If they do not exist yet, confirm the connection library supports an initial context
# before deploying; create the namespace/database, then replace root with a scoped user.
SURREAL_NAMESPACE=clearflow
SURREAL_DATABASE=clearflow

# MCP transport: stdio for local use; http for remote ChatGPT MCP
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_BASE_URL=https://surreal-mcp.duckdns.org

# Auth0 OAuth (set these in Coolify secrets; never commit real values)
AUTH0_CONFIG_URL=https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration
AUTH0_CLIENT_ID=REPLACE_WITH_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=REPLACE_WITH_AUTH0_CLIENT_SECRET
AUTH0_AUDIENCE=https://surreal-mcp.duckdns.org

# Optional connection pool tuning
# SURREAL_POOL_SIZE=10
# SURREAL_POOL_MIN_SIZE=2
# SURREAL_CONNECTION_TIMEOUT=30
# SURREAL_POOL_TIMEOUT=10
